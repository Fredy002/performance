# Server only: copy to .env.local and set the key locally.
# Never prefix secrets with VITE_: those variables are public in the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional workspace selection for keys that require it.
# ANTHROPIC_WORKSPACE_ID=wrkspc_your_workspace

# Exact frontend origin when it is hosted separately (no path or trailing slash).
# CLAUDE_ALLOWED_ORIGIN=https://your-user.github.io

# Production server binds to this computer on port 3000 by default.
# HOST=127.0.0.1
# PORT=3000

# Public build-time endpoint URL for separately hosted frontend and API.
# This variable must never contain secrets.
# VITE_STATEMENT_API_URL=https://api.example.com/api/analyze-statement
